{
  "name": "Page patients",
  "category": "Pages",
  "description": "Page de liste des patients avec recherche, filtres et résultats synthétiques.",
  "variants": {},
  "content": {
    "header": {
      "label": "Header",
      "type": "component-params",
      "ref": "header-nav",
      "default": {
        "variant": "light",
        "sticky": true,
        "logoText": "MonSite",
        "ctaText": "Nouveau patient",
        "showThemeToggle": true,
        "themeToggleLabel": "Mode sombre"
      }
    },
    "footer": {
      "label": "Footer",
      "type": "component-params",
      "ref": "footer",
      "default": {
        "variant": "dark",
        "logoText": "MonSite",
        "tagline": "Suivi patient clair et organisé.",
        "copyright": "© 2025 MonSite. Tous droits réservés."
      }
    }
  },
  "parts": {
    "header": {
      "label": "Header",
      "component": "header-nav",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "light",
          "sticky": true,
          "ctaVariant": "auto",
          "ctaSize": "sm",
          "ctaFull": false,
          "ctaDisabled": false,
          "showThemeToggle": true
        },
        "content": {
          "logoText": "MonSite",
          "ctaText": "Nouveau patient",
          "themeToggleLabel": "Mode sombre"
        }
      }
    },
    "footer": {
      "label": "Footer",
      "component": "footer",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "dark"
        },
        "content": {
          "logoText": "MonSite",
          "tagline": "Suivi patient clair et organisé.",
          "copyright": "© 2025 MonSite. Tous droits réservés."
        }
      }
    },
    "input": {
      "label": "Recherche patient",
      "component": "input",
      "mode": "single",
      "autoBind": true
    },
    "select": {
      "label": "Filtres",
      "component": "select",
      "mode": "single",
      "autoBind": true
    },
    "button": {
      "label": "Actions filtres",
      "component": "button",
      "mode": "single",
      "autoBind": true
    }
  },
  "collections": {
    "patients": {
      "label": "Liste patients",
      "kind": "list",
      "itemComponent": "patient-row",
      "mode": "bulk",
      "autoBind": false
    }
  }
}
