<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Formulaire - MonSite</title>
  <link rel="stylesheet" href="/dev/assets/scss/style.scss">
</head>
<body>
  {% set previewHeader = __previewParts.header.params|default({}) %}
  {% set previewFooter = __previewParts.footer.params|default({}) %}
  {% set previewFamilies = __previewFamilies|default({}) %}
  {% set previewInstances = __previewInstances|default({}) %}
  {% set previewLayoutGroups = __previewLayoutGroups|default({}) %}

  {% set header = {
    variant: previewHeader.variant|default('light'),
    sticky: previewHeader.sticky|default(true),
    logoText: previewHeader.logoText|default('MonSite'),
  showThemeToggle: previewHeader.showThemeToggle|default(true),
  themeToggleLabel: previewHeader.themeToggleLabel|default('Mode sombre'),
    cta: {
      variant: previewHeader.ctaVariant|default('primary'),
      size: previewHeader.ctaSize|default('md'),
      full: previewHeader.ctaFull|default(false),
      disabled: previewHeader.ctaDisabled|default(false),
      text: previewHeader.ctaText|default('Commencer')
    }
  } %}
  {% set footer = {
    variant: previewFooter.variant|default('dark'),
    logoText: previewFooter.logoText|default('MonSite'),
    tagline: previewFooter.tagline|default('Construisons quelque chose de grand.'),
    copyright: previewFooter.copyright|default('© 2025 MonSite. Tous droits réservés.')
  } %}

  {% set inputFamily = previewFamilies.inputs.params|default({}) %}
  {% set selectFamily = previewFamilies.selects.params|default({}) %}
  {% set radioFamily = previewFamilies.radios.params|default({}) %}
  {% set switchFamily = previewFamilies.switches.params|default({}) %}
  {% set checkboxFamily = previewFamilies.checkboxes.params|default({}) %}
  {% set buttonFamily = previewFamilies.buttons.params|default({}) %}

  {% set firstNameField = inputFamily|merge(previewInstances.firstName.params|default({})) %}
  {% set lastNameField = inputFamily|merge(previewInstances.lastName.params|default({})) %}
  {% set emailField = inputFamily|merge(previewInstances.email.params|default({})) %}
  {% set phoneField = inputFamily|merge(previewInstances.phone.params|default({})) %}
  {% set landlinePhoneField = inputFamily|merge(previewInstances.landlinePhone.params|default({})) %}
  {% set birthDateField = inputFamily|merge(previewInstances.birthDate.params|default({})) %}
  {% set ageField = inputFamily|merge(previewInstances.age.params|default({})) %}
  {% set countryField = selectFamily|merge(previewInstances.country.params|default({})) %}
  {% set passwordField = inputFamily|merge(previewInstances.password.params|default({})) %}
  {% set passwordConfirmField = inputFamily|merge(previewInstances.passwordConfirm.params|default({})) %}
  {% set profileField = selectFamily|merge(previewInstances.profile.params|default({})) %}
  {% set subscriptionField = radioFamily|merge(previewInstances.subscription.params|default({})) %}
  {% set notifEmailField = switchFamily|merge(previewInstances.notifEmail.params|default({})) %}
  {% set notifSmsField = switchFamily|merge(previewInstances.notifSms.params|default({})) %}
  {% set newsletterField = switchFamily|merge(previewInstances.newsletter.params|default({})) %}
  {% set termsField = checkboxFamily|merge(previewInstances.terms.params|default({})) %}
  {% set marketingField = checkboxFamily|merge(previewInstances.marketing.params|default({})) %}
  {% set cancelAction = buttonFamily|merge(previewInstances.cancelAction.params|default({})) %}
  {% set submitAction = buttonFamily|merge(previewInstances.submitAction.params|default({})) %}

  {% include 'dev/components/header-nav/header-nav.twig' with {
    variant: header.variant,
    sticky: header.sticky,
    logoText: header.logoText,
    showThemeToggle: header.showThemeToggle,
    themeToggleLabel: header.themeToggleLabel,
    cta: header.cta,
    links: [
      { label: 'Accueil', href: '#' },
      { label: 'Articles', href: '#' },
      { label: 'Tarifs', href: '#' },
      { label: 'Contact', href: '#', active: true }
    ]
  } %}

  <main class="form-page" id="main-content">
    <div class="form-page__inner">
      <header class="form-page__header">
        <h1 class="form-page__title">Créer un compte</h1>
        <p class="form-page__subtitle">Remplissez les informations ci-dessous pour rejoindre MonSite.</p>
      </header>

      <form class="form-page__form" novalidate>
        <section class="form-page__section">
          <h2 class="form-page__section-title">Informations personnelles</h2>

          <div class="grid grid--gap-lg" data-gf-component="grid">
            <div class="grid-item grid--cols-12 grid--md-cols-6">
              {% include 'dev/components/input/input.twig' with {
                id: 'prenom',
                label: firstNameField.label|default('Prénom'),
                type: firstNameField.type|default('text'),
                size: firstNameField.size|default('md'),
                disabled: firstNameField.disabled|default(false),
                required: firstNameField.required|default(true),
                hasError: firstNameField.hasError|default(false),
                placeholder: firstNameField.placeholder|default('ex : Jean'),
                helpText: firstNameField.helpText|default(''),
                errorMessage: firstNameField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
            <div class="grid-item grid--cols-12 grid--md-cols-6">
              {% include 'dev/components/input/input.twig' with {
                id: 'nom',
                label: lastNameField.label|default('Nom'),
                type: lastNameField.type|default('text'),
                size: lastNameField.size|default('md'),
                disabled: lastNameField.disabled|default(false),
                required: lastNameField.required|default(true),
                hasError: lastNameField.hasError|default(false),
                placeholder: lastNameField.placeholder|default('ex : Dupont'),
                helpText: lastNameField.helpText|default(''),
                errorMessage: lastNameField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
          </div>

          <div class="grid grid--gap-lg" data-gf-component="grid">
            <div class="grid-item grid--cols-12 grid--md-cols-4">
              {% include 'dev/components/input/input.twig' with {
                id: 'email',
                label: emailField.label|default('Adresse e-mail'),
                type: emailField.type|default('email'),
                size: emailField.size|default('md'),
                disabled: emailField.disabled|default(false),
                required: emailField.required|default(true),
                hasError: emailField.hasError|default(false),
                placeholder: emailField.placeholder|default('ex : jean@exemple.fr'),
                helpText: emailField.helpText|default('Connexion et notifications.'),
                errorMessage: emailField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
            <div class="grid-item grid--cols-12 grid--md-cols-4">
              {% include 'dev/components/input/input.twig' with {
                id: 'tel',
                label: phoneField.label|default('Téléphone'),
                type: phoneField.type|default('tel'),
                size: phoneField.size|default('md'),
                disabled: phoneField.disabled|default(false),
                required: phoneField.required|default(false),
                hasError: phoneField.hasError|default(false),
                placeholder: phoneField.placeholder|default('ex : +33 6 12 34 56 78'),
                helpText: phoneField.helpText|default(''),
                errorMessage: phoneField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
            <div class="grid-item grid--cols-12 grid--md-cols-4">
              {% include 'dev/components/input/input.twig' with {
                id: 'tel-fixe',
                label: landlinePhoneField.label|default('Tél. fixe'),
                type: landlinePhoneField.type|default('tel'),
                size: landlinePhoneField.size|default('md'),
                disabled: landlinePhoneField.disabled|default(false),
                required: landlinePhoneField.required|default(false),
                hasError: landlinePhoneField.hasError|default(false),
                placeholder: landlinePhoneField.placeholder|default('ex : +33 5 12 34 56 78'),
                helpText: landlinePhoneField.helpText|default(''),
                errorMessage: landlinePhoneField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
          </div>

          <div class="grid grid--gap-lg" data-gf-component="grid">
            <div class="grid-item grid--cols-12 grid--md-cols-4">
              {% include 'dev/components/input/input.twig' with {
                id: 'naissance',
                label: birthDateField.label|default('Date de naissance'),
                type: birthDateField.type|default('date'),
                size: birthDateField.size|default('md'),
                disabled: birthDateField.disabled|default(false),
                required: birthDateField.required|default(false),
                hasError: birthDateField.hasError|default(false),
                placeholder: birthDateField.placeholder|default(''),
                helpText: birthDateField.helpText|default(''),
                errorMessage: birthDateField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
            <div class="grid-item grid--cols-12 grid--md-cols-4">
              {% include 'dev/components/input/input.twig' with {
                id: 'age',
                label: ageField.label|default('Âge'),
                type: ageField.type|default('number'),
                size: ageField.size|default('md'),
                disabled: ageField.disabled|default(false),
                required: ageField.required|default(false),
                hasError: ageField.hasError|default(false),
                placeholder: ageField.placeholder|default('ex : 30'),
                helpText: ageField.helpText|default(''),
                errorMessage: ageField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
            <div class="grid-item grid--cols-12 grid--md-cols-4">
              {% include 'dev/components/select/select.twig' with {
                id: 'pays',
                label: countryField.label|default('Pays'),
                size: countryField.size|default('md'),
                disabled: countryField.disabled|default(false),
                required: countryField.required|default(true),
                hasError: countryField.hasError|default(false),
                placeholder: countryField.placeholder|default('Choisissez un pays'),
                helpText: countryField.helpText|default(''),
                errorMessage: countryField.errorMessage|default('Veuillez sélectionner une option.'),
                options: [
                  { value: 'fr', label: 'France' },
                  { value: 'be', label: 'Belgique' },
                  { value: 'ch', label: 'Suisse' },
                  { value: 'ca', label: 'Canada' },
                  { value: 'lu', label: 'Luxembourg' }
                ]
              } %}
            </div>
          </div>
        </section>

        <section class="form-page__section">
          <h2 class="form-page__section-title">Accès au compte</h2>

          <div class="grid grid--gap-lg" data-gf-component="grid">
            <div class="grid-item grid--cols-12 grid--md-cols-6">
              {% include 'dev/components/input/input.twig' with {
                id: 'password',
                label: passwordField.label|default('Mot de passe'),
                type: passwordField.type|default('password'),
                size: passwordField.size|default('md'),
                disabled: passwordField.disabled|default(false),
                required: passwordField.required|default(true),
                hasError: passwordField.hasError|default(false),
                placeholder: passwordField.placeholder|default('Min. 8 caractères'),
                helpText: passwordField.helpText|default('Majuscule, chiffre et caractère spécial recommandés.'),
                errorMessage: passwordField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
            <div class="grid-item grid--cols-12 grid--md-cols-6">
              {% include 'dev/components/input/input.twig' with {
                id: 'password-confirm',
                label: passwordConfirmField.label|default('Confirmer le mot de passe'),
                type: passwordConfirmField.type|default('password'),
                size: passwordConfirmField.size|default('md'),
                disabled: passwordConfirmField.disabled|default(false),
                required: passwordConfirmField.required|default(true),
                hasError: passwordConfirmField.hasError|default(false),
                placeholder: passwordConfirmField.placeholder|default('Répétez le mot de passe'),
                helpText: passwordConfirmField.helpText|default(''),
                errorMessage: passwordConfirmField.errorMessage|default('Ce champ est invalide.')
              } %}
            </div>
          </div>

          <div class="grid grid--gap-lg" data-gf-component="grid">
            <div class="grid-item grid--cols-12 grid--md-cols-6">
              {% include 'dev/components/select/select.twig' with {
                id: 'profil',
                label: profileField.label|default('Type de profil'),
                size: profileField.size|default('md'),
                disabled: profileField.disabled|default(false),
                required: profileField.required|default(false),
                hasError: profileField.hasError|default(false),
                placeholder: profileField.placeholder|default('Choisissez un profil'),
                helpText: profileField.helpText|default(''),
                errorMessage: profileField.errorMessage|default('Veuillez sélectionner une option.'),
                options: [
                  { value: 'dev', label: 'Développeur' },
                  { value: 'designer', label: 'Designer' },
                  { value: 'manager', label: 'Chef de projet' },
                  { value: 'other', label: 'Autre' }
                ]
              } %}
            </div>
          </div>
        </section>

        <section class="form-page__section">
          <h2 class="form-page__section-title">Préférences</h2>

          <div class="grid grid--gap-xl" data-gf-component="grid">
            <div class="grid-item grid--cols-12 grid--md-cols-6">
              {% include 'dev/components/radio/radio.twig' with {
                name: 'abonnement',
                legend: subscriptionField.legend|default('Abonnement'),
                disabled: subscriptionField.disabled|default(false),
                hasError: subscriptionField.hasError|default(false),
                inline: subscriptionField.inline|default(false),
                errorMessage: subscriptionField.errorMessage|default('Veuillez choisir une option.'),
                value: 'mensuel',
                options: [
                  { value: 'gratuit', label: 'Gratuit - fonctions de base' },
                  { value: 'mensuel', label: 'Mensuel - 9 €/mois' },
                  { value: 'annuel', label: 'Annuel - 79 €/an' }
                ]
              } %}
            </div>
            <div class="grid-item grid--cols-12 grid--md-cols-6">
              <div class="form-page__switches">
                {% include 'dev/components/switch/switch.twig' with {
                  id: 'notif-email',
                  label: notifEmailField.label|default('Notifications par e-mail'),
                  checked: notifEmailField.checked|default(true),
                  disabled: notifEmailField.disabled|default(false),
                  size: notifEmailField.size|default('md'),
                  labelOn: notifEmailField.labelOn|default('Activé'),
                  labelOff: notifEmailField.labelOff|default('Désactivé')
                } %}
                {% include 'dev/components/switch/switch.twig' with {
                  id: 'notif-sms',
                  label: notifSmsField.label|default('Notifications par SMS'),
                  checked: notifSmsField.checked|default(false),
                  disabled: notifSmsField.disabled|default(false),
                  size: notifSmsField.size|default('md'),
                  labelOn: notifSmsField.labelOn|default('Activé'),
                  labelOff: notifSmsField.labelOff|default('Désactivé')
                } %}
                {% include 'dev/components/switch/switch.twig' with {
                  id: 'newsletter',
                  label: newsletterField.label|default('Recevoir la newsletter'),
                  checked: newsletterField.checked|default(true),
                  disabled: newsletterField.disabled|default(false),
                  size: newsletterField.size|default('md'),
                  labelOn: newsletterField.labelOn|default('Activé'),
                  labelOff: newsletterField.labelOff|default('Désactivé')
                } %}
              </div>
            </div>
          </div>
        </section>

        <section class="form-page__section">
          <h2 class="form-page__section-title">Consentements</h2>

          {% include 'dev/components/checkbox/checkbox.twig' with {
            id: 'cgu',
            label: termsField.label|default("J'accepte les conditions générales d'utilisation et la politique de confidentialité."),
            checked: termsField.checked|default(false),
            disabled: termsField.disabled|default(false),
            hasError: termsField.hasError|default(false),
            errorMessage: termsField.errorMessage|default('Vous devez accepter les conditions.'),
            required: true
          } %}
          {% include 'dev/components/checkbox/checkbox.twig' with {
            id: 'marketing',
            label: marketingField.label|default("J'accepte de recevoir des offres commerciales personnalisées."),
            checked: marketingField.checked|default(false),
            disabled: marketingField.disabled|default(false),
            hasError: marketingField.hasError|default(false),
            errorMessage: marketingField.errorMessage|default('')
          } %}
        </section>

        <div class="form-page__actions">
          {% include 'dev/components/button/button.twig' with {
            text: cancelAction.text|default('Annuler'),
            variant: cancelAction.variant|default('ghost'),
            size: cancelAction.size|default('md'),
            full: cancelAction.full|default(false),
            disabled: cancelAction.disabled|default(false)
          } %}
          {% include 'dev/components/button/button.twig' with {
            text: submitAction.text|default('Créer mon compte'),
            variant: submitAction.variant|default('primary'),
            size: submitAction.size|default('md'),
            full: submitAction.full|default(false),
            disabled: submitAction.disabled|default(false)
          } %}
        </div>
      </form>
    </div>
  </main>

  {% include 'dev/components/footer/footer.twig' with {
    variant: footer.variant,
    logoText: footer.logoText,
    tagline: footer.tagline,
    copyright: footer.copyright
  } %}
</body>
</html>
