{
  "name": "Page listing",
  "category": "Pages",
  "description": "Page de liste d'articles avec header, grille de cards et footer.",
  "variants": {
    "gridCols": {
      "label": "Colonnes",
      "type": "select",
      "default": "3",
      "options": [
        "1",
        "2",
        "3"
      ]
    }
  },
  "content": {
    "header": {
      "label": "Header",
      "type": "component-params",
      "ref": "header-nav",
      "default": {
        "variant": "light",
        "sticky": true,
        "logoText": "MonSite",
        "ctaText": "Commencer"
      }
    },
    "footer": {
      "label": "Footer",
      "type": "component-params",
      "ref": "footer",
      "default": {
        "variant": "dark",
        "logoText": "MonSite",
        "tagline": "Construisons quelque chose de grand.",
        "copyright": "© 2025 MonSite. Tous droits réservés."
      }
    }
  },
  "parts": {
    "header": {
      "label": "Header",
      "component": "header-nav",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "light",
          "sticky": true,
          "ctaVariant": "auto",
          "ctaSize": "sm",
          "ctaFull": false,
          "ctaDisabled": false
        },
        "content": {
          "logoText": "MonSite",
          "ctaText": "Commencer"
        }
      }
    },
    "footer": {
      "label": "Footer",
      "component": "footer",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "dark"
        },
        "content": {
          "logoText": "MonSite",
          "tagline": "Construisons quelque chose de grand.",
          "copyright": "© 2025 MonSite. Tous droits réservés."
        }
      }
    },
    "card": {
      "label": "card",
      "component": "card",
      "mode": "single",
      "autoBind": true
    },
    "header-nav": {
      "label": "header-nav",
      "component": "header-nav",
      "mode": "single",
      "autoBind": true
    }
  },
  "collections": {
    "articles": {
      "label": "Cards listing",
      "kind": "list",
      "itemComponent": "card",
      "mode": "bulk",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "default",
          "hasImage": true,
          "hasCta": true
        },
        "content": {
          "ctaText": "Lire l'article"
        }
      },
      "exclude": {
        "variants": [
          "horizontal",
          "ctaVariant",
          "ctaSize",
          "ctaFull",
          "ctaDisabled"
        ],
        "content": [
          "title",
          "text"
        ]
      }
    }
  }
}