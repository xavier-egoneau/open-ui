<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Patients — MonSite</title>
  <link rel="stylesheet" href="/dev/assets/scss/style.scss">
</head>
<body>

  {% include 'dev/components/header-nav/header-nav.twig' with {
    variant: header.variant,
    sticky: header.sticky,
    logoText: header.logoText,
    showThemeToggle: header.showThemeToggle,
    themeToggleLabel: header.themeToggleLabel,
    cta: header.cta,
    links: [
      { label: 'Accueil', href: '#' },
      { label: 'Patients', href: '#', active: true },
      { label: 'Agenda', href: '#' },
      { label: 'Paramètres', href: '#' }
    ]
  } %}

  <main class="patients-page" id="main-content">
    <section class="patients-page__hero">
      <div class="patients-page__hero-inner">
        <div>
          <p class="patients-page__eyebrow">Dossier patient</p>
          <h1 class="patients-page__title">Liste des patients</h1>
          <p class="patients-page__subtitle">Retrouvez rapidement un patient et affinez la liste avec les filtres principaux.</p>
        </div>
        <div class="patients-page__summary" aria-label="Résumé patients">
          <span class="patients-page__summary-value">128</span>
          <span class="patients-page__summary-label">patients suivis</span>
        </div>
      </div>
    </section>

    <section class="patients-page__content" aria-label="Recherche et liste des patients">
      <form class="patients-page__filters" aria-label="Filtres patients">
        <div class="patients-page__filters-header">
          <h2 class="patients-page__filters-title">Affiner la recherche</h2>
          <p class="patients-page__filters-help">Recherche par nom, statut, praticien ou date de dernière visite.</p>
        </div>

        <div class="patients-page__filters-grid">
          {% include 'dev/components/input/input.twig' with {
            id: 'patient-search',
            label: 'Recherche patient',
            type: 'search',
            placeholder: 'Nom, téléphone ou e-mail',
            helpText: '',
            size: 'md'
          } %}

          {% include 'dev/components/select/select.twig' with {
            id: 'patient-status',
            label: 'Statut',
            placeholder: 'Tous les statuts',
            size: 'md',
            options: [
              { value: 'active', label: 'Suivi actif' },
              { value: 'new', label: 'Nouveau' },
              { value: 'callback', label: 'À rappeler' }
            ]
          } %}

          {% include 'dev/components/select/select.twig' with {
            id: 'patient-practitioner',
            label: 'Praticien',
            placeholder: 'Tous les praticiens',
            size: 'md',
            options: [
              { value: 'martin', label: 'Dr Martin' },
              { value: 'lefevre', label: 'Dr Lefèvre' },
              { value: 'bernard', label: 'Dr Bernard' }
            ]
          } %}

          <div class="patients-page__filters-actions">
            {% include 'dev/components/button/button.twig' with {
              text: 'Rechercher',
              variant: 'primary',
              size: 'md'
            } %}
            {% include 'dev/components/button/button.twig' with {
              text: 'Réinitialiser',
              variant: 'ghost',
              size: 'md'
            } %}
          </div>
        </div>
      </form>

      <section class="patients-page__list" aria-label="Résultats patients">
        <div class="patients-page__list-header">
          <h2 class="patients-page__list-title">Patients récents</h2>
          <p class="patients-page__list-count">4 résultats affichés</p>
        </div>

        <div class="patients-page__cards" role="list">
          {% for patient in patients %}
            {% include 'dev/components/patient-row/patient-row.twig' with patient %}
          {% endfor %}
        </div>
      </section>
    </section>
  </main>

  {% include 'dev/components/footer/footer.twig' with {
    variant: footer.variant,
    logoText: footer.logoText,
    tagline: footer.tagline,
    copyright: footer.copyright
  } %}

</body>
</html>
