{
  "name": "Page formulaire",
  "category": "Pages",
  "description": "Page de création de compte avec composants de formulaire, header et footer.",
  "variants": {},
  "content": {},
  "parts": {
    "header": {
      "label": "Header",
      "component": "header-nav",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "light",
          "sticky": true,
          "ctaVariant": "primary",
          "ctaSize": "md",
          "ctaFull": false,
          "ctaDisabled": false,
          "showThemeToggle": true
        },
        "content": {
          "logoText": "MonSite",
          "ctaText": "Commencer",
          "themeToggleLabel": "Mode sombre"
        }
      }
    },
    "footer": {
      "label": "Footer",
      "component": "footer",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "dark"
        },
        "content": {
          "logoText": "MonSite",
          "tagline": "Construisons quelque chose de grand.",
          "copyright": "© 2025 MonSite. Tous droits réservés."
        }
      }
    },
    "input": {
      "label": "input",
      "component": "input",
      "mode": "single",
      "autoBind": true
    },
    "header-nav": {
      "label": "header-nav",
      "component": "header-nav",
      "mode": "single",
      "autoBind": true
    }
  },
  "families": {
    "inputs": {
      "label": "Inputs",
      "component": "input",
      "mode": "shared",
      "autoBind": true,
      "exclude": {
        "variants": [
          "type",
          "required"
        ],
        "content": [
          "label",
          "placeholder",
          "helpText",
          "errorMessage"
        ]
      },
      "defaults": {
        "variants": {
          "size": "md",
          "disabled": false,
          "hasError": false
        }
      }
    },
    "selects": {
      "label": "Selects",
      "component": "select",
      "mode": "shared",
      "autoBind": true,
      "exclude": {
        "variants": [
          "required"
        ],
        "content": [
          "label",
          "placeholder",
          "helpText",
          "errorMessage"
        ]
      },
      "defaults": {
        "variants": {
          "size": "md",
          "disabled": false,
          "hasError": false
        }
      }
    },
    "radios": {
      "label": "Radios",
      "component": "radio",
      "mode": "shared",
      "autoBind": true,
      "exclude": {
        "content": [
          "legend",
          "errorMessage"
        ]
      },
      "defaults": {
        "variants": {
          "disabled": false,
          "hasError": false,
          "inline": false
        }
      }
    },
    "switches": {
      "label": "Switches",
      "component": "switch",
      "mode": "shared",
      "autoBind": true,
      "exclude": {
        "variants": [
          "checked"
        ],
        "content": [
          "label",
          "labelOn",
          "labelOff"
        ]
      },
      "defaults": {
        "variants": {
          "disabled": false,
          "size": "md"
        }
      }
    },
    "checkboxes": {
      "label": "Checkboxes",
      "component": "checkbox",
      "mode": "shared",
      "autoBind": true,
      "exclude": {
        "variants": [
          "checked"
        ],
        "content": [
          "label",
          "errorMessage"
        ]
      },
      "defaults": {
        "variants": {
          "disabled": false,
          "hasError": false
        }
      }
    },
    "buttons": {
      "label": "Buttons",
      "component": "button",
      "mode": "shared",
      "autoBind": true,
      "exclude": {
        "variants": [
          "variant",
          "full"
        ],
        "content": [
          "text"
        ]
      },
      "defaults": {
        "variants": {
          "size": "md",
          "disabled": false
        }
      }
    }
  },
  "instances": {
    "firstName": {
      "label": "Prénom",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "text",
          "required": true
        },
        "content": {
          "label": "Prénom",
          "placeholder": "ex : Jean",
          "helpText": ""
        }
      }
    },
    "lastName": {
      "label": "Nom",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "text",
          "required": true
        },
        "content": {
          "label": "Nom",
          "placeholder": "ex : Dupont",
          "helpText": ""
        }
      }
    },
    "email": {
      "label": "Email",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "email",
          "required": true
        },
        "content": {
          "label": "Adresse e-mail",
          "placeholder": "ex : jean@exemple.fr",
          "helpText": "Connexion et notifications."
        }
      }
    },
    "phone": {
      "label": "Téléphone",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "tel",
          "required": false
        },
        "content": {
          "label": "Téléphone",
          "placeholder": "ex : +33 6 12 34 56 78",
          "helpText": ""
        }
      }
    },
    "landlinePhone": {
      "label": "Téléphone fixe",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "tel",
          "required": false
        },
        "content": {
          "label": "Tél. fixe",
          "placeholder": "ex : +33 5 12 34 56 78",
          "helpText": ""
        }
      }
    },
    "birthDate": {
      "label": "Date de naissance",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "date",
          "required": false
        },
        "content": {
          "label": "Date de naissance",
          "placeholder": "",
          "helpText": ""
        }
      }
    },
    "age": {
      "label": "Âge",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "number",
          "required": false
        },
        "content": {
          "label": "Âge",
          "placeholder": "ex : 30",
          "helpText": ""
        }
      }
    },
    "country": {
      "label": "Pays",
      "component": "select",
      "family": "selects",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "required": true
        },
        "content": {
          "label": "Pays",
          "placeholder": "Choisissez un pays",
          "helpText": ""
        }
      }
    },
    "password": {
      "label": "Mot de passe",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "password",
          "required": true
        },
        "content": {
          "label": "Mot de passe",
          "placeholder": "Min. 8 caractères",
          "helpText": "Majuscule, chiffre et caractère spécial recommandés."
        }
      }
    },
    "passwordConfirm": {
      "label": "Confirmation mot de passe",
      "component": "input",
      "family": "inputs",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "type": "password",
          "required": true
        },
        "content": {
          "label": "Confirmer le mot de passe",
          "placeholder": "Répétez le mot de passe",
          "helpText": ""
        }
      }
    },
    "profile": {
      "label": "Type de profil",
      "component": "select",
      "family": "selects",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "required": false
        },
        "content": {
          "label": "Type de profil",
          "placeholder": "Choisissez un profil",
          "helpText": ""
        }
      }
    },
    "subscription": {
      "label": "Abonnement",
      "component": "radio",
      "family": "radios",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "content": {
          "legend": "Abonnement"
        }
      }
    },
    "notifEmail": {
      "label": "Notification email",
      "component": "switch",
      "family": "switches",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "checked": true
        },
        "content": {
          "label": "Notifications par e-mail",
          "labelOn": "Activé",
          "labelOff": "Désactivé"
        }
      }
    },
    "notifSms": {
      "label": "Notification SMS",
      "component": "switch",
      "family": "switches",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "checked": false
        },
        "content": {
          "label": "Notifications par SMS",
          "labelOn": "Activé",
          "labelOff": "Désactivé"
        }
      }
    },
    "newsletter": {
      "label": "Newsletter",
      "component": "switch",
      "family": "switches",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "checked": true
        },
        "content": {
          "label": "Recevoir la newsletter",
          "labelOn": "Activé",
          "labelOff": "Désactivé"
        }
      }
    },
    "terms": {
      "label": "CGU",
      "component": "checkbox",
      "family": "checkboxes",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "checked": false
        },
        "content": {
          "label": "J'accepte les conditions générales d'utilisation et la politique de confidentialité.",
          "errorMessage": "Vous devez accepter les conditions."
        }
      }
    },
    "marketing": {
      "label": "Marketing",
      "component": "checkbox",
      "family": "checkboxes",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "checked": false
        },
        "content": {
          "label": "J'accepte de recevoir des offres commerciales personnalisées.",
          "errorMessage": ""
        }
      }
    },
    "cancelAction": {
      "label": "Bouton annuler",
      "component": "button",
      "family": "buttons",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "ghost",
          "full": false
        },
        "content": {
          "text": "Annuler"
        }
      }
    },
    "submitAction": {
      "label": "Bouton creer compte",
      "component": "button",
      "family": "buttons",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "primary",
          "full": false
        },
        "content": {
          "text": "Créer mon compte"
        }
      }
    }
  },
  "layoutGroups": {}
}
