{% set variant           = variant|default('default') %}
{% set size             = size|default('md') %}
{% set disabled         = disabled|default(false) %}
{% set placeholder      = placeholder|default('Sélectionnez une option') %}
{% set placement        = placement|default('bottom-left') %}
{% set selectedValue    = selectedValue|default('') %}
{% set selectedLabel    = selectedLabel|default('') %}
{% set name             = name|default('dropdown-' ~ random()) %}
{% set id               = id|default(name) %}
{% set searchPlaceholder = searchPlaceholder|default('Rechercher...') %}
{% set hasSearch        = hasSearch|default(false) %}
{% set hasGroups        = hasGroups|default(false) %}
{% set searchable       = searchable|default(false) %}
{% set hasIcons         = hasIcons|default(false) %}

{% set options = options|default([
  { value: 'opt1', label: 'Option 1' },
  { value: 'opt2', label: 'Option 2' },
  { value: 'opt3', label: 'Option 3', disabled: true },
  { value: 'opt4', label: 'Option 4' }
]) %}


{% set groups = groups|default([
  {
    title: 'Groupe 1',
    options: [
      { value: 'g1-opt1', label: 'Option A' },
      { value: 'g1-opt2', label: 'Option B' }
    ]
  },
  {
    title: 'Groupe 2',
    options: [
      { value: 'g2-opt1', label: 'Option C' },
      { value: 'g2-opt2', label: 'Option D' }
    ]
  }
]) %}


<div
  class="dropdown dropdown--{{ size }}{% if disabled %} dropdown--disabled{% endif %} dropdown--{{ placement }}"
  data-gf-component="dropdown"
  data-gf-dropdown
  {% if disabled %}aria-disabled="true"{% endif %}
>

  {# Hidden input for form value #}
  <input
    type="hidden"
    name="{{ name }}"
    value="{{ selectedValue }}"
    {% if disabled %}disabled{% endif %}
  >

  {# Trigger Button #}
  <button
    class="dropdown__trigger"
    type="button"
    id="{{ id }}"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-labelledby="{{ id }}-label"
    {% if disabled %}disabled{% endif %}
    data-gf-dropdown-trigger
  >
    <span class="dropdown__label" id="{{ id }}-label">
      {{ selectedLabel|default(placeholder) }}
    </span>
    <span class="dropdown__arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </span>
  </button>

  {# Dropdown Menu #}
  <div
    class="dropdown__menu"
    role="listbox"
    id="{{ id }}-menu"
    aria-labelledby="{{ id }}"
    tabindex="-1"
    data-gf-dropdown-menu
  >


    {# Search Field (searchable variant) #}
    {% if searchable %}
      <div class="dropdown__search">
        <svg class="dropdown__search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          class="dropdown__search-input"
          type="text"
          placeholder="{{ searchPlaceholder }}"
          data-gf-dropdown-search
          aria-label="{{ searchPlaceholder }}"
        >
        <button
          class="dropdown__search-clear"
          type="button"
          aria-label="Effacer la recherche"
          data-gf-dropdown-search-clear
          hidden
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    {% endif %}

    {# Options List (simple/with icons) #}
    {% if not hasGroups %}
      <div class="dropdown__options" data-gf-dropdown-options>
        {% for option in options %}
          {% set isSelected = selectedValue == option.value %}
          <button
            class="dropdown__option{% if isSelected %} dropdown__option--selected{% endif %}{% if option.disabled|default(false) %} dropdown__option--disabled{% endif %}"
            type="button"
            role="option"
            value="{{ option.value }}"
            {% if isSelected %}aria-selected="true"{% else %}aria-selected="false"{% endif %}
            {% if option.disabled|default(false) %}aria-disabled="true"{% endif %}
            {% if hasIcons and option.icon %}data-gf-dropdown-option-icon="{{ option.icon }}"{% endif %}
            data-gf-dropdown-option
          >
            {% if hasIcons and option.icon %}
              <span class="dropdown__option-icon" aria-hidden="true">
                {{ option.icon|raw }}
              </span>
            {% endif %}
            <span class="dropdown__option-text">{{ option.label }}</span>
            {% if isSelected %}
              <span class="dropdown__option-check" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
            {% endif %}
          </button>
          {% if option.separator|default(false) %}
            <div class="dropdown__separator" role="separator" aria-orientation="horizontal"></div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {# Options with Groups #}
    {% if hasGroups %}
      <div class="dropdown__groups" data-gf-dropdown-options>
        {% for group in groups %}
          {% if group.title %}
            <div class="dropdown__group">
              <span class="dropdown__group-title" role="presentation">{{ group.title }}</span>
          {% endif %}
          {% for option in group.options %}
            {% set isSelected = selectedValue == option.value %}
            <button
              class="dropdown__option{% if isSelected %} dropdown__option--selected{% endif %}{% if option.disabled|default(false) %} dropdown__option--disabled{% endif %}"
              type="button"
              role="option"
              value="{{ option.value }}"
              {% if isSelected %}aria-selected="true"{% else %}aria-selected="false"{% endif %}
              {% if option.disabled|default(false) %}aria-disabled="true"{% endif %}
              data-gf-dropdown-option
            >
              <span class="dropdown__option-text">{{ option.label }}</span>
              {% if isSelected %}
                <span class="dropdown__option-check" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                </span>
              {% endif %}
            </button>
          {% endfor %}
          {% if group.title %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}


    {# No Results (searchable) #}
    <div class="dropdown__no-results" data-gf-dropdown-no-results hidden>
      <span class="dropdown__no-results-text">Aucune option trouvée</span>
    </div>

  </div>

</div>