{
  "name": "Footer",
  "level": "organism",
  "category": "Navigation",
  "description": "Pied de page avec logo, colonnes de liens et mentions légales.",
  "variants": {
    "variant": {
      "label": "Variante",
      "type": "select",
      "default": "dark",
      "options": ["dark", "light"]
    }
  },
  "content": {
    "logoText": {
      "label": "Logo (texte)",
      "type": "text",
      "default": "MonSite"
    },
    "tagline": {
      "label": "Tagline",
      "type": "text",
      "default": "Construisons quelque chose de grand."
    },
    "copyright": {
      "label": "Copyright",
      "type": "text",
      "default": "© 2025 MonSite. Tous droits réservés."
    },
    "columns": {
      "label": "Colonnes de liens",
      "type": "array",
      "default": [
        { "title": "Produit",    "links": [{ "label": "Fonctionnalités", "href": "#" }, { "label": "Tarifs", "href": "#" }] },
        { "title": "Ressources", "links": [{ "label": "Documentation",   "href": "#" }, { "label": "Blog",   "href": "#" }] },
        { "title": "Entreprise", "links": [{ "label": "À propos",        "href": "#" }, { "label": "Contact","href": "#" }] }
      ]
    },
    "legalLinks": {
      "label": "Liens légaux",
      "type": "array",
      "default": [
        { "label": "Confidentialité",      "href": "#" },
        { "label": "Conditions",           "href": "#" },
        { "label": "Cookies",              "href": "#" }
      ]
    }
  }
}
