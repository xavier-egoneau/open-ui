{
  "name": "Patient row",
  "level": "molecule",
  "category": "Data display",
  "description": "Ligne carte synthétique pour afficher un patient dans une liste avec identité, contact, statut et praticien.",
  "variants": {},
  "content": {
    "name": {
      "label": "Nom",
      "type": "text",
      "default": "Marie Dubois"
    },
    "birthDate": {
      "label": "Date de naissance",
      "type": "text",
      "default": "14/03/1982"
    },
    "phone": {
      "label": "Téléphone",
      "type": "text",
      "default": "+33 6 12 34 56 78"
    },
    "email": {
      "label": "E-mail",
      "type": "text",
      "default": "marie.dubois@example.fr"
    },
    "practitioner": {
      "label": "Praticien",
      "type": "text",
      "default": "Dr Martin"
    },
    "status": {
      "label": "Statut",
      "type": "text",
      "default": "Suivi actif"
    },
    "lastVisit": {
      "label": "Dernière visite",
      "type": "text",
      "default": "18 mai 2026"
    }
  }
}
