{% set name = name|default('Patient') %}
{% set birthDate = birthDate|default('') %}
{% set phone = phone|default('') %}
{% set email = email|default('') %}
{% set practitioner = practitioner|default('') %}
{% set status = status|default('') %}
{% set lastVisit = lastVisit|default('') %}
{% set initial = initial|default(name|slice(0, 1)) %}

<article class="patient-row" role="listitem" data-gf-component="patient-row">
  <div class="patient-row__avatar" aria-hidden="true">{{ initial }}</div>

  <div class="patient-row__main">
    <h3 class="patient-row__name">{{ name }}</h3>
    <p class="patient-row__meta">Né(e) le {{ birthDate }}{% if lastVisit %} · {{ lastVisit }}{% endif %}</p>
  </div>

  <div class="patient-row__contact">
    {% if phone %}<a href="tel:{{ phone|replace({' ': ''}) }}">{{ phone }}</a>{% endif %}
    {% if email %}<a href="mailto:{{ email }}">{{ email }}</a>{% endif %}
  </div>

  <div class="patient-row__side">
    {% if status %}<span class="patient-row__badge">{{ status }}</span>{% endif %}
    {% if practitioner %}<span class="patient-row__practitioner">{{ practitioner }}</span>{% endif %}
  </div>
</article>
