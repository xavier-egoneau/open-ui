{% set variant  = variant|default('light') %}
{% set sticky   = sticky|default(false) %}
{% set logoText = logoText|default('MonSite') %}
{% set showThemeToggle = showThemeToggle|default(true) %}
{% set themeToggleLabel = themeToggleLabel|default('Mode sombre') %}
{% set previewCta = __previewParts.cta.params|default(cta|default({})) %}
{% set cta = {
  variant: previewCta.variant|default('auto'),
  size: previewCta.size|default('sm'),
  full: previewCta.full|default(false),
  disabled: previewCta.disabled|default(false),
  text: previewCta.text|default('Commencer')
} %}

{% set links = links|default([
  { label: 'Accueil',    href: '#' },
  { label: 'Produits',   href: '#' },
  { label: 'Tarifs',     href: '#' },
  { label: 'Contact',    href: '#' }
]) %}

{% set resolvedCtaVariant = cta.variant == 'auto' ? (variant == 'dark' ? 'outline' : 'primary') : cta.variant %}

<header class="header-nav header-nav--{{ variant }}{% if sticky %} header-nav--sticky{% endif %}" role="banner" data-gf-component="header-nav">
  <div class="header-nav__inner">

    <a href="/" class="header-nav__logo" aria-label="Retour à l'accueil">
      <span class="header-nav__logo-mark" aria-hidden="true">◈</span>
      <span class="header-nav__logo-name">{{ logoText }}</span>
    </a>

    <nav class="header-nav__nav" aria-label="Navigation principale">
      <ul class="header-nav__list" role="list">
        {% for link in links %}
          <li class="header-nav__item">
            <a
              href="{{ link.href|default('#') }}"
              class="header-nav__link{% if link.active|default(false) %} header-nav__link--active{% endif %}"
              {% if link.active|default(false) %}aria-current="page"{% endif %}
            >
              {{ link.label|default('Lien') }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header-nav__actions">
      {% if showThemeToggle %}
        <button
          class="header-nav__theme-toggle"
          type="button"
          aria-pressed="false"
          aria-label="Activer le mode sombre"
          data-theme-toggle
        >
          <span class="header-nav__theme-icon" aria-hidden="true">☾</span>
          <span class="header-nav__theme-label">{{ themeToggleLabel }}</span>
        </button>
      {% endif %}

      <div
        class="header-nav__cta"
        data-gf-node-type="part"
        data-gf-node-id="cta"
        data-gf-child-component="button"
        data-gf-node-label="CTA"
        data-gf-exposed="true"
      >
        {% include 'dev/components/button/button.twig' with {
          text: cta.text,
          variant: resolvedCtaVariant,
          size: cta.size,
          full: cta.full,
          disabled: cta.disabled
        } %}
      </div>
    </div>

    {% if showThemeToggle %}
      <script>
        (() => {
          const storageKey = 'open-ui-theme';
          const root = document.documentElement;
          const toggle = document.querySelector('[data-theme-toggle]');
          if (!toggle) return;

          const label = toggle.querySelector('.header-nav__theme-label');
          const icon = toggle.querySelector('.header-nav__theme-icon');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const savedTheme = localStorage.getItem(storageKey);
          const initialTheme = savedTheme || (prefersDark ? 'dark' : 'light');

          const applyTheme = (theme) => {
            const isDark = theme === 'dark';
            root.dataset.theme = theme;
            toggle.setAttribute('aria-pressed', String(isDark));
            toggle.setAttribute('aria-label', isDark ? 'Activer le mode clair' : 'Activer le mode sombre');
            if (label) label.textContent = isDark ? 'Mode clair' : 'Mode sombre';
            if (icon) icon.textContent = isDark ? '☀' : '☾';
          };

          applyTheme(initialTheme);

          toggle.addEventListener('click', () => {
            const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
            localStorage.setItem(storageKey, nextTheme);
            applyTheme(nextTheme);
          });
        })();
      </script>
    {% endif %}

  </div>
</header>
