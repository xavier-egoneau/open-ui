{
  "name": "Header Nav",
  "level": "organism",
  "category": "Navigation",
  "description": "En-tête de page avec logo, liens de navigation, bouton d’action principal et bascule clair/sombre.",
  "variants": {
    "variant": {
      "label": "Variante",
      "type": "select",
      "default": "light",
      "options": [
        "light",
        "dark"
      ]
    },
    "sticky": {
      "label": "Sticky",
      "type": "checkbox",
      "default": false
    },
    "showThemeToggle": {
      "label": "Afficher la bascule thème",
      "type": "checkbox",
      "default": true
    }
  },
  "content": {
    "logoText": {
      "label": "Logo (texte)",
      "type": "text",
      "default": "MonSite"
    },
    "themeToggleLabel": {
      "label": "Libellé bascule thème",
      "type": "text",
      "default": "Mode sombre"
    }
  },
  "parts": {
    "cta": {
      "label": "CTA",
      "component": "button",
      "mode": "single",
      "autoBind": true,
      "defaults": {
        "variants": {
          "variant": "auto",
          "size": "sm",
          "full": false,
          "disabled": false
        },
        "content": {
          "text": "Commencer"
        }
      }
    }
  }
}
