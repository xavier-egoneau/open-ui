{
  "name": "Alert",
  "level": "atom",
  "category": "Feedback",
  "description": "Composant atomique affichant un message contextuel de notification (success, error, warning, info) avec icono, texte et possibilité de dismiss",
  "variants": {
    "variant": {
      "label": "Type",
      "type": "select",
      "default": "info",
      "options": [
        "success",
        "error",
        "warning",
        "info"
      ]
    },
    "dismissible": {
      "label": "Fermable",
      "type": "checkbox",
      "default": false
    }
  },
  "content": {
    "title": {
      "label": "Titre (optionnel)",
      "type": "text",
      "default": ""
    },
    "message": {
      "label": "Message",
      "type": "text",
      "default": "Opération réussie."
    }
  }
}