{% set size         = size|default('md') %}
{% set id           = id|default('select-custom-' ~ random()) %}
{% set name         = name|default(id) %}
{% set label        = label|default('Sélection') %}
{% set placeholder  = placeholder|default('Choisissez une option') %}
{% set value        = value|default('') %}
{% set disabled     = disabled|default(false) %}
{% set required     = required|default(false) %}
{% set hasError     = hasError|default(false) %}
{% set errorMessage = errorMessage|default('Veuillez sélectionner une option.') %}
{% set helpText     = helpText|default('') %}
{% set options      = options|default([
  { value: 'fr', label: 'France' },
  { value: 'be', label: 'Belgique' },
  { value: 'ch', label: 'Suisse' },
  { value: 'ca', label: 'Canada' }
]) %}

<div class="select-custom{% if disabled %} select-custom--disabled{% endif %}{% if hasError %} select-custom--error{% endif %}" data-gf-component="select-custom">


  <label class="select-custom__label" for="{{ id }}">
    {{ label }}
    {% if required %}
      <span class="select-custom__required" aria-hidden="true">*</span>
    {% endif %}
  </label>

  <div class="select-custom__wrapper select-custom__wrapper--{{ size }}">
    <select
      class="select-custom__field"
      id="{{ id }}"
      name="{{ name }}"
      {% if disabled %}disabled{% endif %}
      {% if required %}required aria-required="true"{% endif %}
      {% if hasError %}aria-invalid="true" aria-describedby="{{ id }}-error"
      {% elseif helpText %}aria-describedby="{{ id }}-help"{% endif %}
    >
      {% if placeholder %}
        <option value="" {% if not value %}selected{% endif %} disabled>{{ placeholder }}</option>
      {% endif %}
      {% for option in options %}
        <option value="{{ option.value|default('') }}"{% if value == option.value|default('') %} selected{% endif %}>
          {{ option.label|default('') }}
        </option>
      {% endfor %}
    </select>

    <span class="select-custom__arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </span>
  </div>

  {% if hasError %}
    <p class="select-custom__error" id="{{ id }}-error" role="alert">{{ errorMessage }}</p>
  {% elseif helpText %}
    <p class="select-custom__help" id="{{ id }}-help">{{ helpText }}</p>
  {% endif %}

</div>