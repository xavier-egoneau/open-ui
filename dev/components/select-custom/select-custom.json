{
  "name": "Select Custom",
  "level": "molecule",
  "category": "Forms",
  "description": "Un bloc de sélection personnalisé stylisé (select natif redesigné) avec un apparence plus moderne, des coins arrondis ($radius-lg), une flèche personnalisée SVG, un focus visible avec outline primary, et une transition smooth sur hover.",
  "variants": {
    "size": {
      "label": "Taille",
      "type": "select",
      "default": "md",
      "options": [
        "sm",
        "md",
        "lg"
      ]
    },
    "disabled": {
      "label": "Désactivé",
      "type": "checkbox",
      "default": false
    },
    "required": {
      "label": "Requis",
      "type": "checkbox",
      "default": false
    },
    "hasError": {
      "label": "Erreur",
      "type": "checkbox",
      "default": false
    }
  },
  "content": {
    "label": {
      "label": "Label",
      "type": "text",
      "default": "Pays"
    },
    "placeholder": {
      "label": "Placeholder",
      "type": "text",
      "default": "Choisissez un pays"
    },
    "helpText": {
      "label": "Texte d'aide",
      "type": "text",
      "default": ""
    },
    "errorMessage": {
      "label": "Message d'erreur",
      "type": "text",
      "default": "Veuillez sélectionner une option."
    },
    "options": {
      "label": "Options",
      "type": "array",
      "default": [
        {
          "value": "fr",
          "label": "France"
        },
        {
          "value": "be",
          "label": "Belgique"
        },
        {
          "value": "ch",
          "label": "Suisse"
        },
        {
          "value": "ca",
          "label": "Canada"
        }
      ]
    }
  }
}