{% set id = id|default('drawer') %}
{% set position = position|default('right') %}
{% set open = open|default(true) %}
{% set overlay = overlay|default(true) %}
{% set showClose = showClose|default(true) %}
{% set title = title|default('Panneau latéral') %}
{% set description = description|default('') %}
{% set closeLabel = closeLabel|default('Fermer le panneau') %}
{% set footer = footer|default('') %}
{% set body = body|default('<p>Contenu du panneau.</p>') %}
{% set labelledby = id ~ '-title' %}
{% set describedby = description ? id ~ '-description' : '' %}

<div class="drawer{% if open %} drawer--open{% endif %}" data-gf-component="drawer" data-gf-drawer>
  {% if overlay %}
    <div class="drawer__overlay" aria-hidden="true"></div>
  {% endif %}

  <aside
    id="{{ id }}"
    class="drawer__panel drawer__panel--{{ position }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="{{ labelledby }}"
    {% if describedby %}aria-describedby="{{ describedby }}"{% endif %}
    tabindex="-1"
  >
    <header class="drawer__header">
      <div class="drawer__heading">
        <h2 class="drawer__title" id="{{ labelledby }}">{{ title }}</h2>
        {% if description %}
          <p class="drawer__description" id="{{ describedby }}">{{ description }}</p>
        {% endif %}
      </div>

      {% if showClose %}
        <button class="drawer__close" type="button" aria-label="{{ closeLabel }}" data-gf-drawer-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      {% endif %}
    </header>

    <div class="drawer__body">
      {{ body|raw }}
    </div>

    {% if footer %}
      <footer class="drawer__footer">
        {{ footer|raw }}
      </footer>
    {% endif %}
  </aside>
</div>
